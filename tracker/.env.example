# ─────────────────────────────────────────────────────────────
#  TEMPLATE ONLY — never put real credentials in this file.
#  It is committed to git. Copy it to .env (which is ignored):
#
#      copy .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
# Any PostgreSQL. Local is the default; a hosted one is only needed if
# something outside this machine has to read the data — the Vercel site
# and the n8n workflow both do, and neither can reach localhost.
#
#   local      postgresql://postgres:PASSWORD@localhost:5432/shopify_tracker_db
#   hosted     postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# Leave unset entirely to use the local PGlite file instead — no install.
DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/shopify_tracker_db

# Connections held per serverless instance. Keep small.
PG_MAX=3

# ── Google Drive (the daily CSVs live here) ─────────────────
# The folder id, or just paste the whole folder URL.
DRIVE_FOLDER_ID=https://drive.google.com/drive/folders/YOUR_FOLDER_ID

# Pick ONE of the two. See DRIVE.md for the five-minute setup.
#
# A) Service account — recommended, never involves a browser.
#    Share the Drive folder with the key's client_email address.
GOOGLE_APPLICATION_CREDENTIALS=C:/secure/tracker-ingest-key.json
#    ...or paste the key file's contents inline instead of a path:
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
#
# B) OAuth refresh token — reuses the app the Python uploader already uses.
# GOOGLE_OAUTH_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxx
# GOOGLE_OAUTH_REFRESH_TOKEN=1//xxx

# ── Remote ingest trigger (n8n) ─────────────────────────────────
# Set this and POST /api/ingest starts the nightly job from anywhere.
# Leave it unset and the route does not exist at all — see N8N.md.
# Anyone holding this token can write to the production database, so
# generate a long random one:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# INGEST_TOKEN=

# What to do with each CSV once it has been ingested: delete, archive,
# trash or none. Defaults to "none", because the other three need write
# access to Drive and an API key does not have it — the run is refused
# outright rather than just skipping the tidy-up. Switch to "delete" once
# a service account is set up; it is the only one that frees quota.
# INGEST_CLEANUP=delete
