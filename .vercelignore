# Keep the upload small. Patterns match at any depth, like .gitignore —
# anchor with a leading slash when you mean "only at the repo root".
node_modules
tracker/data
*.csv
For Python/
.claude
deploy.log

# Plan / sample documents live at the repo root only.
# NEVER use a bare *.html here — that would also drop tracker/public/*.html,
# which IS the site.
/Shopify-Price-Tracker-Plan.html
/Shopify-Price-Tracker-Plan-EN.html
/Sample-Report-Alkaram-Studio.html
