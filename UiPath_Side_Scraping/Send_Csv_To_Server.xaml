      <TryCatch.Finally>
        <Sequence DisplayName="Finally : close off and report" sap2010:Annotation.AnnotationText="Finally holds ONE activity, not a list. Two children set the property twice and Studio then refuses to open the file at all, with &quot;&apos;Finally&apos; property has already been set on &apos;TryCatch&apos;&quot; — an error that names the property rather than the extra child that caused it. So both steps live inside this Sequence." sap2010:WorkflowViewState.IdRef="Sequence_Finally">
          <ui:AppendLine ContinueOnError="True" DisplayName="Append Line : finished" FileName="[strLogFile]" Text="[Now.AddHours(9).ToString(&quot;dd-MM-yyyy HH:mm:ss&quot;) + &quot; | ===== workflow finished (&quot; + strStatus + &quot;) =====&quot; + Environment.NewLine]" sap2010:Annotation.AnnotationText="In Finally so the log is closed off whichever way the run ended." sap2010:WorkflowViewState.IdRef="AppendLine_Finish" />

          <uga:SendEmailConnections sap2010:Annotation.AnnotationText="Sent on every run, success or failure — it sits in the Finally, so the figures always go out. strStatus in the subject is OK or FAILED.&#xA;&#xA;PICK THE CONNECTION FIRST. ConnectionId is left empty on purpose: it is a GUID belonging to one tenant&apos;s Gmail connection and cannot be hardcoded here. Open this activity in Studio and choose your Gmail account from the dropdown once. Until that is done every run ends with &quot;Value cannot be null (Parameter &apos;creatorContainer&apos;)&quot;.&#xA;&#xA;The body is the summary file the script writes: files sent, skipped, failed, how many stores are in the database, and the reason." ArgumentAttachmentPaths="{x:Null}" ArgumentAttachments="{x:Null}" AttachmentPaths="{x:Null}" Bcc="{x:Null}" Cc="{x:Null}" ConnectionAccountName="{x:Null}" ContinueOnError="True" ReplyTo="{x:Null}" SingleAttachment="{x:Null}" TextBody="{x:Null}" AttachmentInputMode="UseExisting" AuthScopesInvalid="False" Body="[If(File.Exists(&quot;C:\CSV_Data\Log_Files\last_summary.txt&quot;), File.ReadAllText(&quot;C:\CSV_Data\Log_Files\last_summary.txt&quot;), &quot;The run stopped before it could write a summary. See &quot; + strLogFile)]" ConnectionId="" DisplayName="Send Email : summary" sap:VirtualizedContainerService.HintSize="416,48" sap2010:WorkflowViewState.IdRef="SendEmailConnections_Summary" Importance="Normal" InputType="HTML" SaveAsDraft="False" Subject="[&quot;Shopify CSV upload | &quot; + Now.AddHours(9).ToString(&quot;yyyy-MM-dd&quot;) + &quot; | &quot; + strStatus]" To="[New String(){&quot;techbugs86@gmail.com&quot;, &quot;ayankhan343536@gmail.com&quot;}]" UseConnectionService="True">
