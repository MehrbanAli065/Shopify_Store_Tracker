<Activity mc:Ignorable="sap sap2010" x:Class="Send_Csv_To_Server" VisualBasic.Settings="{x:Null}" sap2010:WorkflowViewState.IdRef="Send_Csv_To_Server_1" xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:s="clr-namespace:System;assembly=System.Private.CoreLib" xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation" xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation" xmlns:scg="clr-namespace:System.Collections.Generic;assembly=System.Private.CoreLib" xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=System.Private.CoreLib" xmlns:sma="clr-namespace:System.Management.Automation;assembly=System.Management.Automation" xmlns:uga="clr-namespace:UiPath.GSuite.Activities;assembly=UiPath.GSuite.Activities" xmlns:ugage="clr-namespace:UiPath.GSuite.Activities.Gmail.Enums;assembly=UiPath.GSuite.Activities" xmlns:upr="clr-namespace:UiPath.Platform.ResourceHandling;assembly=UiPath.Platform" xmlns:usau="clr-namespace:UiPath.Shared.Activities.Utils;assembly=UiPath.GSuite.Activities" xmlns:ui="http://schemas.uipath.com/workflow/activities" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Collections.ObjectModel</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Text</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <Sequence DisplayName="Send CSV To Server" sap2010:Annotation.AnnotationText="Sends one day of scraped CSVs from this machine to the tracker server and writes a _DONE marker only once every file is confirmed there, at the right size.&#xA;&#xA;SELF-CONTAINED. Drop it into any project that already has UiPath.System.Activities and press Run File. Nothing else in the project is touched and no package has to be added.&#xA;&#xA;WHERE TO EDIT&#xA;Open the Invoke Power Shell activity. The first twelve lines of the script are the settings — source folder, server, user, key path, remote folder, log folder, how many attempts, and the time budget.&#xA;&#xA;HOW IT RETRIES&#xA;Two layers, and they cover different failures.&#xA;  Inside the script: up to 12 passes with growing waits — 30s, 1m, 2m, 5m, 10m, 15m, then 30m — capped by a 4 hour budget. Each pass asks the server what it already has, compares by NAME AND SIZE, and sends only what is missing or short. A file that arrived complete is never sent again, so a second pass moves the gap and not the 2.5 GB.&#xA;  Around the activity: a Retry Scope, for the case where the PowerShell process itself dies rather than the script failing.&#xA;&#xA;WHY POWERSHELL RATHER THAN AN FTP ACTIVITY&#xA;tar piped into ssh moves the day in one connection and compresses it on the way, which is what turns gigabytes from hours into minutes. It also keeps this file free of any package the project does not already have.&#xA;&#xA;WHAT IT NEEDS ON THIS MACHINE&#xA;  - OpenSSH Client and tar (both ship with Windows Server 2019+)&#xA;  - an SSH private key at the path in the settings, whose public half is in the server account&apos;s authorized_keys&#xA;A key, not a password: ssh cannot be given a password unattended, and BatchMode=yes makes it fail fast rather than hang the robot at a prompt.&#xA;&#xA;THE LOG&#xA;C:\CSV_Data\Log_Files\server_log_dd-MM-yyyy.txt — the workflow and the PowerShell write to the same file, so one run reads in sequence." sap2010:WorkflowViewState.IdRef="Sequence_Root">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="strLogFile" />
      <Variable x:TypeArguments="x:String" Default="FAIL" Name="strStatus" />
    </Sequence.Variables>

    <Assign DisplayName="Assign : today's log file" sap2010:Annotation.AnnotationText="Now.AddHours(9) is the same shift the scraper uses to name the day&apos;s folder. Change one and this stops matching the other." sap2010:WorkflowViewState.IdRef="Assign_LogFile">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[strLogFile]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[Path.Combine(&quot;C:\CSV_Data\Log_Files&quot;, &quot;server_log_&quot; + Now.AddHours(9).ToString(&quot;dd-MM-yyyy&quot;) + &quot;.txt&quot;)]</InArgument>
      </Assign.Value>
    </Assign>

    <ui:LogMessage DisplayName="Log : starting" Level="Info" Message="[&quot;Send CSV To Server | starting&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_Start" />

    <TryCatch DisplayName="Try Catch : the whole transfer" sap2010:WorkflowViewState.IdRef="TryCatch_Main">
      <TryCatch.Try>
        <Sequence DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_Try">

          <ui:RetryScope LogRetriedExceptions="{x:Null}" RetriedExceptionsLogLevel="{x:Null}" DisplayName="Retry : if the PowerShell process itself dies" NumberOfRetries="2" RetryInterval="00:05:00" sap2010:Annotation.AnnotationText="The second layer, and deliberately shallow: two attempts, five minutes apart.&#xA;&#xA;The script already retries the transfer twelve times on its own and knows which files are still missing. This scope is only for the case it cannot handle — the PowerShell process itself dying, taking that knowledge with it. Restarting it costs nothing, because the first thing the script does is ask the server what already arrived." sap2010:WorkflowViewState.IdRef="RetryScope_1">
            <ui:RetryScope.ActivityBody>
              <ActivityAction>
                <Sequence DisplayName="Send the day" sap2010:WorkflowViewState.IdRef="Sequence_Send">
                  <ui:InvokePowerShell x:TypeArguments="sma:PSObject" ContinueOnError="{x:Null}" CommandText="# ════════════════════════════════════════════════════════════════&#xA;#  SETTINGS — edit these, nothing else&#xA;# ════════════════════════════════════════════════════════════════&#xA;$SourceRoot   = &apos;C:\CSV_Data\Daily_Scrapped_Csv_Files&apos;   # each day is a &lt;date&gt; folder inside this&#xA;$SshHost      = &apos;66.45.238.72&apos;&#xA;$SshUser      = &apos;mehrban&apos;&#xA;$SshKey       = &apos;C:\Users\Administrator\.ssh\tracker_upload&apos;&#xA;$RemoteRoot   = &apos;/home/mehrban/csv&apos;&#xA;$TrackerDir   = &apos;shopify-store-tracker/tracker&apos;          # relative to the ssh user&apos;s home&#xA;$DbName       = &apos;shopify_tracker_db&apos;&#xA;$DbUser       = &apos;tracker&apos;&#xA;$LogFolder    = &apos;C:\CSV_Data\Log_Files&apos;&#xA;$MailTo       = &apos;&apos;        # fallback mail via the server&apos;s Postfix. Left blank because&#xA;                         # the Gmail activity in the workflow sends the summary; fill&#xA;                         # it in only if that connection ever stops working.&#xA;$HoursOffset  = 9        # every date in this system is Now.AddHours(9)&#xA;$MaxAttempts  = 12       # upload passes before it gives up&#xA;$BudgetMin    = 240      # and a hard ceiling in minutes, whichever comes first&#xA;$RunIngest    = $true    # false = only upload, leave the ingest to the server&apos;s cron&#xA;$ForceUpload  = $false   # true = ignore the &quot;already ingested&quot; check and send anyway&#xA;# ════════════════════════════════════════════════════════════════&#xA;#&#xA;# Nothing here assumes how many stores there are. Every count comes from the&#xA;# files actually in the day&apos;s folder, so more stores need no change at all.&#xA;&#xA;$ErrorActionPreference = &apos;Stop&apos;&#xA;&#xA;$stamp   = (Get-Date).AddHours($HoursOffset)&#xA;$DateStr = $stamp.ToString(&apos;yyyy-MM-dd&apos;)&#xA;$LogFile = Join-Path $LogFolder (&apos;server_log_&apos; + $stamp.ToString(&apos;dd-MM-yyyy&apos;) + &apos;.txt&apos;)&#xA;$SummaryFile = Join-Path $LogFolder &apos;last_summary.txt&apos;&#xA;&#xA;if (-not (Test-Path -LiteralPath $LogFolder)) {&#xA;  New-Item -ItemType Directory -Path $LogFolder -Force | Out-Null&#xA;}&#xA;&#xA;# The log is meant to be read by a person at a glance, so: the clock only —&#xA;# the date is already in the file name — and plain sentences rather than tags.&#xA;#&#xA;# Write-Host, not Write-Output, and the difference matters. The activity is&#xA;# InvokePowerShell&lt;PSObject&gt;, so anything left on the output pipeline is cast&#xA;# to PSObject, and a plain String fails that cast with &quot;Unable to cast object&#xA;# of type &apos;System.String&apos;&quot;. Write-Host goes to the host stream instead.&#xA;function Log([string]$msg) {&#xA;  $line = (Get-Date).AddHours($HoursOffset).ToString(&apos;HH:mm:ss&apos;) + &apos;  &apos; + $msg&#xA;  Add-Content -LiteralPath $LogFile -Value $line -Encoding UTF8&#xA;  Write-Host $line&#xA;}&#xA;function LogPlain([string]$msg) {&#xA;  Add-Content -LiteralPath $LogFile -Value $msg -Encoding UTF8&#xA;  Write-Host $msg&#xA;}&#xA;&#xA;$src     = Join-Path $SourceRoot $DateStr&#xA;$target  = $SshUser + &apos;@&apos; + $SshHost&#xA;$remote  = $RemoteRoot + &apos;/&apos; + $DateStr&#xA;# Windows OpenSSH has no connection multiplexing, so every command here pays a&#xA;# full handshake. These three options remove the parts of it that are pure&#xA;# waiting: GSSAPI/Kerberos is offered first by default and has to time out&#xA;# before the key is tried, and IdentitiesOnly stops the agent walking through&#xA;# other keys first. On a machine where each connection was taking about half a&#xA;# minute, this is where most of that went.&#xA;$sshOpts = &apos;-i &quot;&apos; + $SshKey + &apos;&quot; -o BatchMode=yes -o StrictHostKeyChecking=accept-new&apos; +&#xA;           &apos; -o ConnectTimeout=30 -o ServerAliveInterval=30&apos; +&#xA;           &apos; -o GSSAPIAuthentication=no -o PreferredAuthentications=publickey -o IdentitiesOnly=yes&apos;&#xA;&#xA;# What the summary reports. Kept at script scope so the failure path can send&#xA;# the same figures the success path would have.&#xA;$sumTotal   = 0    # CSV files in today&apos;s folder&#xA;$sumSent    = 0    # actually transferred this run&#xA;$sumSkipped = 0    # already on the server, not resent&#xA;$sumFailed  = 0    # still missing when it gave up&#xA;$sumStores  = 0    # stores recorded in the database for this date&#xA;$sumReason  = &apos;&apos;&#xA;$started    = Get-Date&#xA;&#xA;LogPlain &apos;&apos;&#xA;LogPlain &apos;============================================================&apos;&#xA;LogPlain (&quot; Shopify CSV upload   -   &quot; + $DateStr + &quot;   -   started &quot; +&#xA;          (Get-Date).AddHours($HoursOffset).ToString(&apos;HH:mm:ss&apos;))&#xA;LogPlain &apos;============================================================&apos;&#xA;&#xA;# ── the summary mail ─────────────────────────────────────────────&#xA;# Sent through the server&apos;s own Postfix over the ssh connection this script&#xA;# already has — not through an Integration Service connection. So there is no&#xA;# Gmail connection to configure and no credential in this file.&#xA;#&#xA;# It goes out on every outcome, because &quot;how many failed&quot; is only useful if a&#xA;# failure actually sends one. A mail that itself fails is logged and ignored:&#xA;# the files being on the server matters more than the notification.&#xA;function Send-Summary([string]$outcome) {&#xA;  if ([string]::IsNullOrWhiteSpace($MailTo)) { return }&#xA;  $f = Join-Path $env:TEMP (&apos;mail_&apos; + [guid]::NewGuid().ToString(&apos;N&apos;) + &apos;.txt&apos;)&#xA;  try {&#xA;    $mins = [math]::Round(((Get-Date) - $started).TotalMinutes, 1)&#xA;    $body = @(&#xA;      &quot;Day     : $DateStr&quot;&#xA;      &quot;Result  : $outcome&quot;&#xA;      &quot;&quot;&#xA;      &quot;Files   : $sumTotal&quot;&#xA;      &quot;  sent    : $sumSent&quot;&#xA;      &quot;  skipped : $sumSkipped&quot;&#xA;      &quot;  failed  : $sumFailed&quot;&#xA;      &quot;&quot;&#xA;      &quot;Database: $sumStores stores recorded for this date&quot;&#xA;      &quot;Time    : $mins minutes&quot;&#xA;      &quot;&quot;&#xA;      &quot;Reason  : $(if ($sumReason) { $sumReason } else { &apos;none&apos; })&quot;&#xA;    ) -join &quot;`n&quot;&#xA;    $msg = &quot;To: $MailTo`nSubject: Shopify CSV upload | $DateStr | $outcome`nContent-Type: text/plain; charset=UTF-8`n`n$body`n&quot;&#xA;    # UTF8Encoding($false), not [Text.Encoding]::UTF8 — the latter writes a&#xA;    # byte-order mark, and three stray bytes in front of &quot;To:&quot; stop sendmail&#xA;    # finding a recipient. It answers 75 (EX_TEMPFAIL), which reads like a&#xA;    # server problem and is not one.&#xA;    [IO.File]::WriteAllText($f, $msg, (New-Object System.Text.UTF8Encoding($false)))&#xA;    cmd /c &quot;type &quot;&quot;$f&quot;&quot; | ssh $sshOpts $target &quot;&quot;/usr/sbin/sendmail -t&quot;&quot; 2&gt;&amp;1&quot; | Out-Null&#xA;    if ($LASTEXITCODE -eq 0) { Log &quot;Summary mailed to $MailTo&quot; }&#xA;    else { Log &quot;Note: the summary mail did not go out (sendmail $LASTEXITCODE). The run itself is unaffected.&quot; }&#xA;  } catch {&#xA;    Log &quot;Note: the summary mail did not go out - $($_.Exception.Message). The run itself is unaffected.&quot;&#xA;  } finally {&#xA;    Remove-Item -LiteralPath $f -Force -ErrorAction SilentlyContinue&#xA;    # The mail is the last native command to run, so its exit code would&#xA;    # otherwise become the script&apos;s — turning a good run into a failed one&#xA;    # over a notification.&#xA;    $global:LASTEXITCODE = 0&#xA;  }&#xA;}&#xA;&#xA;# The body of the summary mail. Written to a file rather than returned,&#xA;# because the workflow&apos;s Send Email activity can read a file with one&#xA;# expression while anything left on the PowerShell output pipeline would be&#xA;# cast to PSObject and fail.&#xA;function Write-Summary([string]$outcome) {&#xA;  $mins = [math]::Round(((Get-Date) - $started).TotalMinutes, 1)&#xA;  $text = @(&#xA;    &quot;Day     : $DateStr&quot;&#xA;    &quot;Result  : $outcome&quot;&#xA;    &quot;&quot;&#xA;    &quot;Files   : $sumTotal&quot;&#xA;    &quot;  sent    : $sumSent&quot;&#xA;    &quot;  skipped : $sumSkipped&quot;&#xA;    &quot;  failed  : $sumFailed&quot;&#xA;    &quot;&quot;&#xA;    &quot;Database: $sumStores stores recorded for this date&quot;&#xA;    &quot;Time    : $mins minutes&quot;&#xA;    &quot;&quot;&#xA;    &quot;Reason  : $(if ($sumReason) { $sumReason } else { &apos;none&apos; })&quot;&#xA;    &quot;&quot;&#xA;    &quot;Log     : $LogFile&quot;&#xA;  ) -join &quot;`r`n&quot;&#xA;  [IO.File]::WriteAllText($SummaryFile, $text, (New-Object System.Text.UTF8Encoding($false)))&#xA;}&#xA;&#xA;function Write-Footer([string]$outcome) {&#xA;  $mins = [math]::Round(((Get-Date) - $started).TotalMinutes, 1)&#xA;  LogPlain &apos;------------------------------------------------------------&apos;&#xA;  LogPlain (&quot; Result   : &quot; + $outcome)&#xA;  LogPlain (&quot; Files    : &quot; + $sumTotal + &quot;   (sent &quot; + $sumSent + &quot;, skipped &quot; +&#xA;            $sumSkipped + &quot;, failed &quot; + $sumFailed + &quot;)&quot;)&#xA;  LogPlain (&quot; Database : &quot; + $sumStores + &quot; stores recorded for &quot; + $DateStr)&#xA;  LogPlain (&quot; Time     : &quot; + $mins + &quot; minutes&quot;)&#xA;  if ($sumReason) { LogPlain (&quot; Reason   : &quot; + $sumReason) }&#xA;  LogPlain &apos;------------------------------------------------------------&apos;&#xA;  LogPlain &apos;&apos;&#xA;}&#xA;&#xA;# SQL goes to psql on stdin rather than as a -c argument. A query carries&#xA;# single quotes (&apos;success&apos;, the date) and the command already sits inside an&#xA;# ssh string inside a cmd string; piping it in avoids three levels of quoting&#xA;# and the mistakes that come with them.&#xA;function Invoke-Sql([string]$sql) {&#xA;  $f = Join-Path $env:TEMP (&apos;q_&apos; + [guid]::NewGuid().ToString(&apos;N&apos;) + &apos;.sql&apos;)&#xA;  [IO.File]::WriteAllText($f, $sql, [Text.Encoding]::ASCII)&#xA;  try {&#xA;    $out = cmd /c &quot;type &quot;&quot;$f&quot;&quot; | ssh $sshOpts $target &quot;&quot;psql -U $DbUser -h localhost -d $DbName -tA&quot;&quot; 2&gt;&amp;1&quot;&#xA;    if ($LASTEXITCODE -ne 0) { throw &quot;psql failed - $out&quot; }&#xA;    return (@($out) | Where-Object { ($_ -as [string]).Trim() -ne &apos;&apos; } | Select-Object -Last 1)&#xA;  } finally {&#xA;    Remove-Item -LiteralPath $f -Force -ErrorAction SilentlyContinue&#xA;  }&#xA;}&#xA;&#xA;# A regex rather than [int]::TryParse. On current .NET that method has a&#xA;# ReadOnlySpan&lt;char&gt; overload, and PowerShell cannot decide between it and the&#xA;# string one when a [ref] is involved - it fails with &quot;an exception occurred&#xA;# while retrieving member TryParse&quot; before the query result is ever looked at.&#xA;#&#xA;# Both pre-flight numbers in one query, because every trip to the server costs&#xA;# a whole ssh handshake and this machine pays about half a minute for one.&#xA;#&#xA;# The second number is the one that decides anything: how many of THESE files&#xA;# belong to a store that is already recorded for this date. The distinction matters: the database can hold hundreds of stores for&#xA;# today and still be missing every store in this particular folder. Comparing&#xA;# a total against a file count answers a different question and gets it wrong&#xA;# — it skipped a folder whose two stores had just been removed on purpose.&#xA;#&#xA;# starts_with, not LIKE: a csv_prefix is full of underscores and LIKE reads&#xA;# each one as &quot;any character&quot;, which would match the wrong store.&#xA;function Get-DayStatus($files) {&#xA;  $values = ($files | ForEach-Object { &quot;(&apos;&quot; + ($_.Name -replace &quot;&apos;&quot;, &quot;&apos;&apos;&quot;) + &quot;&apos;)&quot; }) -join &apos;,&apos;&#xA;  $sql = @&quot;&#xA;WITH f(name) AS (VALUES $values)&#xA;SELECT&#xA;  (SELECT count(*) FROM scrape_runs&#xA;    WHERE run_date = DATE &apos;$DateStr&apos; AND status IN (&apos;success&apos;,&apos;partial&apos;))&#xA;  || &apos;|&apos; ||&#xA;  (SELECT count(DISTINCT f.name)&#xA;     FROM f&#xA;     JOIN stores s      ON starts_with(f.name, s.csv_prefix)&#xA;     JOIN scrape_runs r ON r.store_id = s.id&#xA;                      AND r.run_date = DATE &apos;$DateStr&apos;&#xA;                      AND r.status IN (&apos;success&apos;,&apos;partial&apos;));&#xA;&quot;@&#xA;  $txt = ([string](Invoke-Sql $sql)).Trim()&#xA;  if ($txt -match &apos;^(\d+)\|(\d+)$&apos;) { return @([int]$matches[1], [int]$matches[2]) }&#xA;  Log &quot;Note: could not read the day&apos;s state from the database, got: &apos;$txt&apos;&quot;&#xA;  return @(0, 0)&#xA;}&#xA;&#xA;# What the server already holds, as name|size. Size matters as much as the&#xA;# name: a transfer killed half way leaves a short file behind, and matching on&#xA;# the name alone would accept it as delivered.&#xA;function Get-RemoteIndex {&#xA;  $raw = cmd /c &quot;ssh $sshOpts $target &quot;&quot;mkdir -p &apos;$remote&apos; &amp;&amp; find &apos;$remote&apos; -maxdepth 1 -type f -name &apos;*.csv&apos; -printf &apos;%f|%s\n&apos;&quot;&quot; 2&gt;&amp;1&quot;&#xA;  if ($LASTEXITCODE -ne 0) { throw &quot;could not read the server folder - $raw&quot; }&#xA;  $idx = @{}&#xA;  foreach ($line in @($raw)) {&#xA;    $t = ($line -as [string]).Trim()&#xA;    if ($t -match &apos;^(.+)\|(\d+)$&apos;) { $idx[$matches[1]] = [int64]$matches[2] }&#xA;  }&#xA;  return $idx&#xA;}&#xA;&#xA;function Size-Text([long]$bytes) {&#xA;  if ($bytes -ge 1MB)      { return &quot;$([math]::Round($bytes / 1MB, 1)) MB&quot; }&#xA;  elseif ($bytes -ge 1KB)  { return &quot;$([math]::Round($bytes / 1KB)) KB&quot; }&#xA;  else                     { return &quot;$bytes bytes&quot; }&#xA;}&#xA;&#xA;try {&#xA;&#xA;  # ── 0 · everything this needs, checked before the files are touched ──&#xA;  if (-not (Test-Path -LiteralPath $src)) { throw &quot;the folder for today does not exist: $src&quot; }&#xA;  $local = @(Get-ChildItem -LiteralPath $src -Filter *.csv -File)&#xA;  if ($local.Count -eq 0) { throw &quot;the folder for today has no CSV files: $src&quot; }&#xA;  $sumTotal = $local.Count&#xA;&#xA;  foreach ($tool in @(&apos;tar.exe&apos;,&apos;ssh.exe&apos;)) {&#xA;    if (-not (Get-Command $tool -ErrorAction SilentlyContinue)) {&#xA;      throw &quot;$tool is not on PATH - turn on the OpenSSH Client feature in Windows&quot;&#xA;    }&#xA;  }&#xA;  if (-not (Test-Path -LiteralPath $SshKey)) { throw &quot;the ssh key is missing: $SshKey&quot; }&#xA;&#xA;  $sizeText = Size-Text (($local | Measure-Object -Property Length -Sum).Sum)&#xA;  Log &quot;Found $($local.Count) CSV files ($sizeText)&quot;&#xA;  Log &quot;From : $src&quot;&#xA;  Log &quot;To   : ${target}:$remote&quot;&#xA;&#xA;  # ── 1 · is this day already in the database? ────────────────────&#xA;  # The same question the manual command answers with &quot;N already done&quot;. If the&#xA;  # database already holds at least as many stores as there are files here,&#xA;  # the day is done — and moving the whole folder to prove it would be waste.&#xA;  # This matters most once the server&apos;s 3-day cleanup has removed the folder:&#xA;  # without the check, the entire day would be sent again for nothing.&#xA;  $state     = Get-DayStatus $local&#xA;  $sumStores = $state[0]&#xA;  $mineDone  = $state[1]&#xA;  if ($mineDone -ge $local.Count -and -not $ForceUpload) {&#xA;    $sumSkipped = $local.Count&#xA;    $sumReason  = &quot;already ingested - all $($local.Count) of these stores are recorded for this date&quot;&#xA;    Log &quot;All $($local.Count) files in this folder belong to stores already recorded for $DateStr.&quot;&#xA;    Log &quot;Nothing to do. (Set ForceUpload to send anyway.)&quot;&#xA;    Send-Summary &apos;nothing to do&apos;&#xA;    Write-Summary &apos;nothing to do&apos;&#xA;  Write-Footer &apos;nothing to do&apos;&#xA;    return&#xA;  }&#xA;  if ($ForceUpload) { Log &quot;ForceUpload is on - sending regardless of what the database holds&quot; }&#xA;  if ($mineDone -gt 0) {&#xA;    Log &quot;$mineDone of these $($local.Count) files are already recorded for $DateStr - the rest still need doing.&quot;&#xA;  } else {&#xA;    Log &quot;None of these $($local.Count) files are in the database for $DateStr yet.&quot;&#xA;  }&#xA;  Log &quot;(The database holds $sumStores stores in total for this date.)&quot;&#xA;&#xA;  # ── 2 · the upload, with resume ─────────────────────────────────&#xA;  # Each pass sends only what is still missing or short, so an interrupted run&#xA;  # picks up where it stopped instead of starting the whole folder again.&#xA;  $listFile  = Join-Path $env:TEMP (&quot;send_list_&quot; + $DateStr + &quot;.txt&quot;)&#xA;  $sent      = $false&#xA;  $lastErr   = &apos;&apos;&#xA;  # Names this run actually put on the wire. Counting &quot;everything the server&#xA;  # was missing at the end&quot; instead would call a file skipped just because an&#xA;  # earlier pass had already delivered it - which is exactly backwards.&#xA;  $sentNames = @{}&#xA;&#xA;  for ($attempt = 1; $attempt -le $MaxAttempts; $attempt++) {&#xA;&#xA;    if (((Get-Date) - $started).TotalMinutes -gt $BudgetMin) {&#xA;      Log &quot;Stopping: the $BudgetMin minute budget is used up after $($attempt-1) attempts.&quot;&#xA;      break&#xA;    }&#xA;&#xA;    try {&#xA;      $have    = Get-RemoteIndex&#xA;      $missing = @($local | Where-Object { -not ($have.ContainsKey($_.Name) -and $have[$_.Name] -eq $_.Length) })&#xA;&#xA;      # A file that arrived complete is never sent again. On a second pass this&#xA;      # is the whole point: only the gap moves, not the whole folder.&#xA;      $already = $local.Count - $missing.Count&#xA;&#xA;      if ($missing.Count -eq 0) {&#xA;        Log &quot;All $($local.Count) files are already on the server, at the right size.&quot;&#xA;        $sent = $true&#xA;        break&#xA;      }&#xA;      if ($already -gt 0) { Log &quot;$already files are already there - not sending those again.&quot; }&#xA;&#xA;      $mb = Size-Text (($missing | Measure-Object -Property Length -Sum).Sum)&#xA;      if ($attempt -eq 1) { Log &quot;Sending $($missing.Count) files ($mb) ...&quot; }&#xA;      else { Log &quot;Attempt $attempt : sending the remaining $($missing.Count) files ($mb) ...&quot; }&#xA;&#xA;      # tar reads the names from a file so a long list cannot overflow the&#xA;      # command line, and so what is sent is exactly what was decided above.&#xA;      [IO.File]::WriteAllText($listFile, (($missing | ForEach-Object { $_.Name }) -join &quot;`n&quot;) + &quot;`n&quot;, [Text.Encoding]::ASCII)&#xA;&#xA;      # One connection, compressed on the way. The pipe runs under cmd because&#xA;      # PowerShell corrupts binary data passed through its own pipeline.&#xA;      $sw  = [Diagnostics.Stopwatch]::StartNew()&#xA;      $out = cmd /c &quot;tar -czf - -C &quot;&quot;$src&quot;&quot; -T &quot;&quot;$listFile&quot;&quot; | ssh $sshOpts $target &quot;&quot;tar -xzf - -C &apos;$remote&apos;&quot;&quot; 2&gt;&amp;1&quot;&#xA;      $sw.Stop()&#xA;      if ($LASTEXITCODE -ne 0) { throw &quot;the transfer exited $LASTEXITCODE - $out&quot; }&#xA;      foreach ($m in $missing) { $sentNames[$m.Name] = $true }&#xA;      Log &quot;Sent in $([math]::Round($sw.Elapsed.TotalMinutes,1)) minutes.&quot;&#xA;&#xA;      # Verify against the server rather than trusting the exit code.&#xA;      $have  = Get-RemoteIndex&#xA;      $short = @($local | Where-Object { -not ($have.ContainsKey($_.Name) -and $have[$_.Name] -eq $_.Length) })&#xA;      if ($short.Count -eq 0) {&#xA;        Log &quot;Verified: all $($local.Count) files are on the server.&quot;&#xA;        $sent = $true&#xA;        break&#xA;      }&#xA;      throw &quot;$($short.Count) files are still missing or short after the transfer&quot;&#xA;    }&#xA;    catch {&#xA;      $lastErr = $_.Exception.Message&#xA;      Log &quot;Attempt $attempt failed: $lastErr&quot;&#xA;    }&#xA;&#xA;    if ($attempt -lt $MaxAttempts) {&#xA;      # Waits grow, then flatten. A rate limit or a dropped link is measured in&#xA;      # minutes, so asking again every thirty seconds only keeps the far end busy.&#xA;      $backoff = @(30, 60, 120, 300, 600, 900, 1800)&#xA;      $wait = $backoff[[math]::Min($attempt - 1, $backoff.Count - 1)]&#xA;      Log &quot;Waiting $wait seconds before attempt $($attempt + 1).&quot;&#xA;      Start-Sleep -Seconds $wait&#xA;    }&#xA;  }&#xA;&#xA;  if (Test-Path -LiteralPath $listFile) { Remove-Item -LiteralPath $listFile -Force -ErrorAction SilentlyContinue }&#xA;&#xA;  # $have already holds what the loop last read from the server, and on a&#xA;  # successful pass that read happened after the transfer - so it is the&#xA;  # answer. Only a run that gave up needs to look again.&#xA;  if (-not $sent) { $have = Get-RemoteIndex }&#xA;  $stillGone = @($local | Where-Object { -not ($have.ContainsKey($_.Name) -and $have[$_.Name] -eq $_.Length) })&#xA;  $sumFailed  = $stillGone.Count&#xA;  $sumSent    = @($local | Where-Object { $sentNames.ContainsKey($_.Name) -and -not ($stillGone.Name -contains $_.Name) }).Count&#xA;  $sumSkipped = $local.Count - $sumSent - $sumFailed&#xA;&#xA;  if (-not $sent) { throw &quot;the upload is incomplete - $sumFailed files never arrived. Last error: $lastErr&quot; }&#xA;&#xA;&#xA;  # -- 3 + 4 + 5 : marker, ingest and the final count, in one connection ------&#xA;  # These were three separate ssh calls: touch _DONE, run the ingest, then ask&#xA;  # the database how it went. Each one is a fresh handshake, and on this machine&#xA;  # a handshake costs far more than the work it carries. So they are one command.&#xA;  #&#xA;  # _DONE first, because the server only treats a folder as a complete day when&#xA;  # that file is in it. Then the ingest -- the same script `npm run ingest:server`&#xA;  # runs, and it skips a store already recorded for this date, so running it&#xA;  # twice costs nothing. Then the count, which is the honest check: the run is&#xA;  # finished when the database says so, not when a script exits zero.&#xA;  #&#xA;  # Each part announces itself, because $LASTEXITCODE can only report the last&#xA;  # command in the chain and that is psql, not the ingest.&#xA;  #&#xA;  # &apos;\&apos;&apos; is how a single quote is written inside a single-quoted shell string.&#xA;  # The SQL needs quotes around the date and the two statuses, and the whole&#xA;  # query has to reach psql as one -c argument.&#xA;  $countSql = &quot;SELECT count(*) FROM scrape_runs WHERE run_date = DATE &apos;\&apos;&apos;$DateStr&apos;\&apos;&apos; AND status IN (&apos;\&apos;&apos;success&apos;\&apos;&apos;,&apos;\&apos;&apos;partial&apos;\&apos;&apos;)&quot;&#xA;  $tail     = &quot;printf DBCOUNT=; psql -U $DbUser -h localhost -d $DbName -tA -c &apos;$countSql&apos;&quot;&#xA;&#xA;  if ($RunIngest) {&#xA;    $ingestOk = $false&#xA;    for ($try = 1; $try -le 2; $try++) {&#xA;      if ($try -eq 1) { Log &quot;Marking the day complete and running the ingest ...&quot; }&#xA;      else { Log &quot;Running the ingest again (attempt $try) ...&quot; }&#xA;&#xA;      $step = &quot;touch &apos;$remote/_DONE&apos; &amp;&amp; echo MARKER_OK &amp;&amp; cd $TrackerDir &amp;&amp; &quot; +&#xA;              &quot;node scripts/ingest-folder.mjs --dir $remote --date $DateStr; &quot; +&#xA;              &quot;echo INGEST_EXIT=`$?; $tail&quot;&#xA;      $sw  = [Diagnostics.Stopwatch]::StartNew()&#xA;      $out = cmd /c &quot;ssh $sshOpts $target &quot;&quot;$step&quot;&quot; 2&gt;&amp;1&quot;&#xA;      $sw.Stop()&#xA;&#xA;      $marker = $false&#xA;      $code   = -1&#xA;      foreach ($line in @($out)) {&#xA;        $t = ($line -as [string]).Trim()&#xA;        if ($t -eq &apos;MARKER_OK&apos;)              { $marker = $true; continue }&#xA;        if ($t -match &apos;^INGEST_EXIT=(\d+)$&apos;) { $code = [int]$matches[1]; continue }&#xA;        if ($t -match &apos;^DBCOUNT=(\d+)$&apos;)     { $sumStores = [int]$matches[1]; continue }&#xA;        # Its own summary lines are the useful part of several hundred.&#xA;        if ($t -match &apos;to ingest|succeeded|already done|unmatched&apos;) { LogPlain (&quot;          &quot; + ($t -replace [char]0x00B7, &apos;|&apos;)) }&#xA;        if ($t -match &apos;(\d+)\s+succeeded\s+.\s+(\d+)\s+failed&apos;) {&#xA;          if ([int]$matches[2] -gt 0) { $sumReason = &quot;$($matches[2]) stores failed to ingest&quot; }&#xA;        }&#xA;      }&#xA;&#xA;      if ($code -lt 0) { throw &quot;the server did not answer during the ingest - $out&quot; }&#xA;      if (-not $marker) { throw &quot;the files are there but _DONE could not be written&quot; }&#xA;      Log &quot;Marked the day complete on the server (_DONE).&quot;&#xA;&#xA;      if ($code -eq 0) {&#xA;        $ingestOk = $true&#xA;        Log &quot;Ingest finished in $([math]::Round($sw.Elapsed.TotalMinutes,1)) minutes.&quot;&#xA;        break&#xA;      }&#xA;      Log &quot;The ingest exited $code on attempt $try.&quot;&#xA;      if ($try -lt 2) { Start-Sleep -Seconds 120 }&#xA;    }&#xA;&#xA;    Log &quot;The database now has $sumStores stores for $DateStr.&quot;&#xA;    if (-not $ingestOk) { throw &quot;the ingest did not finish cleanly - the database has $sumStores stores&quot; }&#xA;  } else {&#xA;    $out = cmd /c &quot;ssh $sshOpts $target &quot;&quot;touch &apos;$remote/_DONE&apos; &amp;&amp; echo MARKER_OK &amp;&amp; $tail&quot;&quot; 2&gt;&amp;1&quot;&#xA;    $marker = $false&#xA;    foreach ($line in @($out)) {&#xA;      $t = ($line -as [string]).Trim()&#xA;      if ($t -eq &apos;MARKER_OK&apos;)          { $marker = $true }&#xA;      if ($t -match &apos;^DBCOUNT=(\d+)$&apos;) { $sumStores = [int]$matches[1] }&#xA;    }&#xA;    if (-not $marker) { throw &quot;the files are there but _DONE could not be written - $out&quot; }&#xA;    Log &quot;Marked the day complete on the server (_DONE).&quot;&#xA;    Log &quot;Upload done. The ingest is left to the server (RunIngest is off).&quot;&#xA;  }&#xA;&#xA;  Send-Summary &apos;complete&apos;&#xA;  Write-Summary &apos;complete&apos;&#xA;  Write-Footer &apos;complete&apos;&#xA;}&#xA;catch {&#xA;  # One place where every failure is turned into a mail carrying the same&#xA;  # figures the success path would have reported, then rethrown so the UiPath&#xA;  # Catch sees a real exception and Orchestrator marks the job Faulted.&#xA;  $sumReason = $_.Exception.Message&#xA;  Log &quot;FAILED: $sumReason&quot;&#xA;  Send-Summary &apos;FAILED&apos;&#xA;  Write-Summary &apos;FAILED&apos;&#xA;  Write-Footer &apos;FAILED&apos;&#xA;  throw&#xA;}" DisplayName="Invoke Power Shell : send the day" IsScript="True" PowerShellProcess="PowerShellCore" sap2010:Annotation.AnnotationText="Everything happens here: read the day&apos;s folder, ask the server what it already has, send only the difference, verify by name and size, then write _DONE.&#xA;&#xA;It appends its own lines to the same log file and throws on failure, so the Catch below sees a real exception rather than having to read output.&#xA;&#xA;The settings are the first twelve lines of the script." sap2010:WorkflowViewState.IdRef="InvokePowerShell`1_1">
                    <ui:InvokePowerShell.Parameters>
                      <scg:Dictionary x:TypeArguments="x:String, InArgument" />
                    </ui:InvokePowerShell.Parameters>
