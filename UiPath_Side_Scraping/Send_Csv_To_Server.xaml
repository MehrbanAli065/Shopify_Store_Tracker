          <ui:LogMessage DisplayName="Log : done" Level="Info" Message="[&quot;Send CSV To Server | OK&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_Ok" />
        </Sequence>
      </TryCatch.Try>
      <TryCatch.Catches>
        <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch_Main">
          <ActivityAction x:TypeArguments="s:Exception">
            <ActivityAction.Argument>
              <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
            </ActivityAction.Argument>
            <Sequence DisplayName="Catch : record it, then fail" sap2010:WorkflowViewState.IdRef="Sequence_Catch">
              <ui:LogMessage DisplayName="Log : failed" Level="Error" Message="[&quot;Send CSV To Server | FAIL | &quot; + exception.Message]" sap2010:WorkflowViewState.IdRef="LogMessage_Fail" />
              <ui:AppendLine ContinueOnError="True" DisplayName="Append Line : the failure" FileName="[strLogFile]" Text="[Now.AddHours(9).ToString(&quot;dd-MM-yyyy HH:mm:ss&quot;) + &quot; | FAILED | &quot; + exception.Message]" sap2010:WorkflowViewState.IdRef="AppendLine_Fail" />
              <Rethrow DisplayName="Rethrow" sap2010:Annotation.AnnotationText="Rethrown on purpose. Orchestrator has to see this job as Faulted — a silent failure means the server quietly has no data for the day and nothing says so." sap2010:WorkflowViewState.IdRef="Rethrow_1" />
            </Sequence>
          </ActivityAction>
        </Catch>
